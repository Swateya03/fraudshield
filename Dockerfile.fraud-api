FROM python:3.11-slim

WORKDIR /app

# Install dependencies first (cached layer — only rebuilds if requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY fraudshield_core/  ./fraudshield_core/
COPY fraud_api/         ./fraud_api/
COPY .env               ./.env

# Create runtime artifact directory
RUN mkdir -p local_store/model_registry

EXPOSE 8000

# Health check — circuit breaker pings this
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["python", "-m", "uvicorn", "fraud_api.main:app",
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]