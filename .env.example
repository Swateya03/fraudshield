# ─────────────────────────────────────────────
# FraudShield MVP — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# MVP: SQLite (no server needed)
DB_URL=sqlite:///local_store/fraud.db
# Production swap (one line change):
# DB_URL=postgresql://fraudshield:CHANGE_ME@localhost:5432/fraudshield

# Connection pool (PostgreSQL only — ignored for SQLite)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_VELOCITY=3600
REDIS_TTL_IDEMPOTENCY=86400

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=CHANGE_ME_USE_A_STRONG_SECRET
# Must match API_TOKEN — Vite exposes VITE_* vars to the browser (import.meta.env)
VITE_API_TOKEN=CHANGE_ME_USE_A_STRONG_SECRET
RATE_LIMIT_PER_SECOND=100

# ── Model ─────────────────────────────────────
MODEL_REGISTRY_PATH=local_store/model_registry
CURRENT_MODEL_VERSION=v1.0.0
FRAUD_THRESHOLD=0.85
REVIEW_THRESHOLD=0.50

# ── Fraud Signal Lists (comma-separated, override without touching code) ──────
# FRAUD_IP_LIST=185.220.101.5,185.220.101.6
# HIGH_RISK_MERCHANT_IDS=m_crypto,m_giftcard,m_jewelry,m_luxury
# MEDIUM_RISK_MERCHANT_IDS=m_bestbuy,m_electronics
# HIGH_RISK_MERCHANT_CATEGORIES=crypto,gift_cards,gambling,wire_transfer
# MEDIUM_RISK_MERCHANT_CATEGORIES=jewelry,electronics,luxury

# ── Currency exchange rates (used for INR normalisation) ─────────────────────
# FX_USD=83.0
# FX_EUR=90.0
# FX_GBP=105.0

# ── Champion / Challenger A/B routing ────────
# Leave CHALLENGER_MODEL_VERSION empty to disable A/B routing.
# Set to a version that exists in MODEL_REGISTRY_PATH to enable it.
# CHALLENGER_MODEL_VERSION=v1.1.0
# CHALLENGER_TRAFFIC_PCT=0.10

# ── Feature Store ─────────────────────────────
# MVP: Redis   Production swap: FEAST_REPO_PATH=./feast_repo
FEATURE_STORE_BACKEND=redis

# ── MLflow ────────────────────────────────────
# Local dev (no server):
MLFLOW_TRACKING_URI=local_store/mlruns
# Docker Compose (mlflow service running):
# MLFLOW_TRACKING_URI=http://localhost:5000
# Production (internal service-to-service):
# MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Drift Detection ───────────────────────────
PSI_THRESHOLD=0.20
DRIFT_CHECK_WINDOW_DAYS=7

# ── Event Publisher ───────────────────────────
# MVP: in-memory   Production swap: kafka
EVENT_PUBLISHER_BACKEND=memory
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_SCORED=scored_transactions

# ── OpenTelemetry tracing ──────────────────────
# Set to enable distributed tracing. Leave empty to disable (default).
# docker-compose exposes Jaeger at localhost:16686 (UI) and :4317 (OTLP gRPC).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Webhook ───────────────────────────────────
# POST payload to this URL for every block (and optionally review/allow) decision.
# Leave empty to disable. WEBHOOK_EVENTS is comma-separated: block,review,allow
# WEBHOOK_URL=https://your-ops-system/hooks/fraud
# WEBHOOK_EVENTS=block

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
