{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "FraudShield CNP Fraud Detection — live model observability",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] }, "unit": "reqps" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Decisions / sec",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(fraudshield_decisions_total[1m]))", "legendFormat": "req/s" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] }, "unit": "percent", "max": 100 }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Block Rate (last 5m)",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "100 * sum(rate(fraudshield_decisions_total{decision=\"block\"}[5m])) / sum(rate(fraudshield_decisions_total[5m]))", "legendFormat": "block %" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.15 }, { "color": "red", "value": 0.20 }] }, "unit": "s" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "p95 Latency",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum(rate(fraudshield_scoring_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "SLA Breaches (>200ms)",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "increase(fraudshield_sla_breaches_total[1h])", "legendFormat": "breaches/hr" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "allow" },  "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "review" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "block" },  "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Decision Rate — Allow / Review / Block",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "sum by (decision) (rate(fraudshield_decisions_total[1m]))", "legendFormat": "{{decision}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" },  "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" },  "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p99" },  "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Scoring Latency — p50 / p95 / p99",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, sum(rate(fraudshield_scoring_latency_seconds_bucket[2m])) by (le))", "legendFormat": "p50" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum(rate(fraudshield_scoring_latency_seconds_bucket[2m])) by (le))", "legendFormat": "p95" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.99, sum(rate(fraudshield_scoring_latency_seconds_bucket[2m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 15 }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Fraud Score Distribution (bucket counts, 1m rate)",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "sum by (le) (rate(fraudshield_score_bucket[1m]))", "legendFormat": "≤{{le}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Decision Rate by Strategy",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "sum by (strategy) (rate(fraudshield_decisions_total[1m]))", "legendFormat": "{{strategy}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 16, "x": 0, "y": 20 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "background" },
      "title": "Active Model",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fraudshield_model_info", "legendFormat": "{{version}} / {{strategy}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short",
          "noValue": "—"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background" },
      "title": "Rollback Target (previous champion)",
      "description": "Version that auto_rollback.py would promote if health checks fail. Empty means no rollback available.",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fraudshield_rollback_target", "legendFormat": "{{version}} / {{strategy}}" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "live block %" },          "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "rollback threshold (+15pp)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Block Rate % — Drift from Training Baseline",
      "description": "If the live block rate deviates >15 pp from the model's training fraud rate, auto-rollback triggers.",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "100 * sum(rate(fraudshield_decisions_total{decision=\"block\"}[5m])) / sum(rate(fraudshield_decisions_total[5m]))", "legendFormat": "live block %" },
        { "datasource": "Prometheus", "expr": "vector(15)", "legendFormat": "rollback threshold (+15pp)" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 12,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "SLA Breach Rate — Rollback Trigger at 5%",
      "description": "Fraction of requests exceeding 200 ms. Sustained breach rate >5% triggers auto-rollback.",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(fraudshield_sla_breaches_total[5m])) / sum(rate(fraudshield_decisions_total[5m]))", "legendFormat": "SLA breach %" },
        { "datasource": "Prometheus", "expr": "vector(0.05)", "legendFormat": "rollback threshold (5%)" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short",
          "thresholds": { "steps": [
            { "color": "green",  "value": null  },
            { "color": "yellow", "value": 0.10  },
            { "color": "red",    "value": 0.20  }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 13,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "PSI Drift per Feature",
      "description": "Population Stability Index per feature. >0.10 = monitor, >0.20 = retrain required. Updated by POST /v1/model/drift or the drift monitor cron.",
      "type": "timeseries",
      "targets": [{
        "datasource": "Prometheus",
        "expr": "fraudshield_psi_score",
        "legendFormat": "{{feature}}"
      }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "champion.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "challenger.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#7BB8F8", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 14,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Median Fraud Score — Champion vs Challenger",
      "description": "p50 score by A/B variant. Divergence between champion and challenger indicates the challenger is scoring differently — investigate before promoting.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le, ab_variant) (rate(fraudshield_score_by_variant_bucket[5m])))",
          "legendFormat": "{{ab_variant}} p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le, ab_variant) (rate(fraudshield_score_by_variant_bucket[5m])))",
          "legendFormat": "{{ab_variant}} p95"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green",  "value": null        },
            { "color": "yellow", "value": 518400      },
            { "color": "red",    "value": 604800      }
          ]},
          "unit": "s",
          "noValue": "no model"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 40 },
      "id": 15,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Model Age",
      "description": "Seconds since the active model was registered. >6 days = yellow, >7 days = red (retrain recommended).",
      "type": "stat",
      "targets": [{
        "datasource": "Prometheus",
        "expr": "time() - fraudshield_model_info",
        "legendFormat": "age"
      }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null  },
            { "color": "red",   "value": 0.01  }
          ]},
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 40 },
      "id": 16,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "SLA Breach Rate (5m)",
      "description": ">1% = warning alert fires. >5% = auto-rollback triggers.",
      "type": "stat",
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(fraudshield_sla_breaches_total[5m])) / sum(rate(fraudshield_decisions_total[5m]))",
        "legendFormat": "breach %"
      }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.10 },
            { "color": "red",    "value": 0.20 }
          ]},
          "unit": "short",
          "noValue": "no drift data"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 40 },
      "id": 17,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "background" },
      "title": "Max PSI (worst feature)",
      "description": "Highest PSI across all monitored features. Triggers FeatureDriftWarning at 0.10, FeatureDriftCritical at 0.20.",
      "type": "stat",
      "targets": [{
        "datasource": "Prometheus",
        "expr": "max(fraudshield_psi_score)",
        "legendFormat": "max PSI"
      }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["fraudshield", "mlops"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "title": "FraudShield — Model Observability",
  "uid": "fraudshield-main",
  "version": 3
}
