# ─────────────────────────────────────────────
# FraudShield MVP — Environment Configuration
# Never commit real secrets. This file is for local dev only.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# MVP: SQLite (no server needed)
DB_URL=sqlite:///local_store/fraud.db
# Production swap (one line change):
# DB_URL=postgresql://fraudshield:fraudshield@localhost:5432/fraudshield

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_VELOCITY=3600       # velocity counters expire after 1 hour
REDIS_TTL_IDEMPOTENCY=86400   # idempotency keys expire after 24 hours

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=dev_token_fraudshield_local_only
RATE_LIMIT_PER_SECOND=100

# ── Model ─────────────────────────────────────
MODEL_REGISTRY_PATH=local_store/model_registry
CURRENT_MODEL_VERSION=v1.0.0
FRAUD_THRESHOLD=0.50          # score above this → block
REVIEW_THRESHOLD=0.20         # score above this → review

# ── Feature Store ─────────────────────────────
# MVP: Redis dict   Production swap: FEAST_REPO_PATH=./feast_repo
FEATURE_STORE_BACKEND=redis

# ── MLflow ────────────────────────────────────
# MVP: local folder   Production swap: MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_URI=local_store/mlruns

# ── Drift Detection ───────────────────────────
PSI_THRESHOLD=0.20            # PSI above this → trigger retraining alert (slide 16: >= 0.20 = critical)
DRIFT_CHECK_WINDOW_DAYS=7     # compare last 7 days vs training baseline

# ── Event Publisher ───────────────────────────
# MVP: in-memory list   Production swap: kafka
EVENT_PUBLISHER_BACKEND=memory
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_SCORED=scored_transactions
# KAFKA_TOPIC_LABELS=fraud_labels

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
