# ─────────────────────────────────────────────
# FraudShield MVP — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# MVP: SQLite (no server needed)
DB_URL=sqlite:///local_store/fraud.db
# Production swap (one line change):
# DB_URL=postgresql://fraudshield:CHANGE_ME@localhost:5432/fraudshield

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_VELOCITY=3600
REDIS_TTL_IDEMPOTENCY=86400

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=CHANGE_ME_USE_A_STRONG_SECRET
RATE_LIMIT_PER_SECOND=100

# ── Model ─────────────────────────────────────
MODEL_REGISTRY_PATH=local_store/model_registry
CURRENT_MODEL_VERSION=v1.0.0
FRAUD_THRESHOLD=0.85
REVIEW_THRESHOLD=0.50

# ── Fraud Signal Lists (comma-separated, override without touching code) ──────
# FRAUD_IP_LIST=185.220.101.5,185.220.101.6
# HIGH_RISK_MERCHANT_IDS=m_crypto,m_giftcard,m_jewelry,m_luxury
# MEDIUM_RISK_MERCHANT_IDS=m_bestbuy,m_electronics
# HIGH_RISK_MERCHANT_CATEGORIES=crypto,gift_cards,gambling,wire_transfer
# MEDIUM_RISK_MERCHANT_CATEGORIES=jewelry,electronics,luxury

# ── Currency exchange rates (used for INR normalisation) ─────────────────────
# FX_USD=83.0
# FX_EUR=90.0
# FX_GBP=105.0

# ── Feature Store ─────────────────────────────
# MVP: Redis   Production swap: FEAST_REPO_PATH=./feast_repo
FEATURE_STORE_BACKEND=redis

# ── MLflow ────────────────────────────────────
# MVP: local folder   Production swap: MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_URI=local_store/mlruns

# ── Drift Detection ───────────────────────────
PSI_THRESHOLD=0.20
DRIFT_CHECK_WINDOW_DAYS=7

# ── Event Publisher ───────────────────────────
# MVP: in-memory   Production swap: kafka
EVENT_PUBLISHER_BACKEND=memory
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_SCORED=scored_transactions

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
